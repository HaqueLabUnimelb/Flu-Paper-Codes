# Copy this file to config/paths.env and replace every /path/to placeholder.
# The copied file is ignored by Git. Do not commit credentials or private paths.

# Curio Seeker and Nextflow
CURIOSEEKER_DIR=/path/to/curioseeker-v3.0.0
CURIOSEEKER_NEXTFLOW_CONFIG=/path/to/curioseeker_slurm.config
FLU_PREPROCESSING_SAMPLESHEET=/path/to/samplesheet_igenome_lung.csv
FLU_PREPROCESSING_OUTPUT_DIR=/path/to/outputs/curioseeker
FLU_PREPROCESSING_WORK_DIR=/path/to/work/curioseeker
FLU_PREPROCESSING_IGENOMES_BASE=/path/to/reference/resource

# Viral mapping
HKX31_SAMPLESHEET=/path/to/samplesheet_hkx31.csv
HKX31_OUTPUT_DIR=/path/to/outputs/hkx31
SARSCOV2_SAMPLESHEET=/path/to/samplesheet_sarscov2.csv
SARSCOV2_OUTPUT_DIR=/path/to/outputs/sarscov2
VIRAL_MAPPING_WORK_DIR=/path/to/work/viral_mapping
VIRAL_IGENOMES_BASE=/path/to/viral/reference/directory

# Feature plots
FLU_PROCESSED_DATA_DIR=/path/to/processed_data
FLU_FEATURE_PLOT_OUTPUT_DIR=/path/to/outputs/feature_plots

# RCTD inputs and outputs
FLU_REFERENCE_RDS=/path/to/PR8_ref.rds
FLU_DAY4_PUCK1_RDS=/path/to/lungST_2_2_QCed_edit.rds
FLU_DAY4_PUCK2_RDS=/path/to/lungST_2_3_QCed_edit.rds
FLU_DAY10_PUCK1_RDS=/path/to/lungST_4_2_QCed_edit.rds
FLU_DAY10_PUCK2_RDS=/path/to/lungST_4_3_QCed_edit.rds
FLU_RCTD_OUTPUT_DIR=/path/to/outputs/rctd
FLU_RCTD_VIS_INPUT_RDS=/path/to/Day10mouseRCTDoutmin30_multi.rds
FLU_RCTD_VIS_OUTPUT=/path/to/outputs/rctd_visualization.pdf

# Revision: gene-list overlap
FLU_FISHER_UNIVERSE=/path/to/background_genes.txt
FLU_FISHER_GENE_LIST_1=/path/to/gene_list_1.txt
FLU_FISHER_GENE_LIST_2=/path/to/gene_list_2.txt
FLU_FISHER_OUTPUT=/path/to/outputs/revision/fisher_gene_overlap.tsv

# Revision: day-4 RCTD follow-up
FLU_RCTD_DAY4_FULL_RDS=/path/to/Day4mouseRCTDoutmin30_multi.rds
FLU_RCTD_DAY4_DOUBLET_RDS=/path/to/outputs/revision/Day4mouseRCTDoutmin30_doublet_same_input.rds
FLU_RCTD_DAY4_REPLICATE_NAMES=puck1_lungST_2_2,puck2_lungST_2_3
FLU_RCTD_MODE_COMPARISON_OUTPUT_DIR=/path/to/outputs/revision/full_vs_doublet_same_input
FLU_RCTD_CELL_PLOT_OUTPUT_DIR=/path/to/outputs/revision/day4_cell_type_plots
FLU_RCTD_LEGACY_DOUBLET_RDS=/path/to/legacy/Day4mouseRCTDoutmin30_editv1
FLU_RCTD_LEGACY_COMPARISON_OUTPUT_DIR=/path/to/outputs/revision/legacy_shared_spot_paired_ttest

# Software environment
FLU_R_ENV_PREFIX=/path/to/conda/environment
FLU_ANACONDA_MODULE=Anaconda3/2024.02-1
